---
/* Resume — faithful re-skin onto the new system (Shell + landing tokens).
   Production composition, type scale, and section structure KEPT verbatim;
   only the visual direction changed: old global.css tokens → --paper/--ink/
   --red, warm-cream sheet → pure --paper, --font-* → --display/--sans/--serif
   (same role split: Tanker shouts, General Sans operates, Literata reads),
   radius → --r, weight 700 → 600 (Bold is banned in the system). Phosphor
   icons swapped for the system's 16-grid line icons. Custom footer dropped —
   Shell's doors finale is the universal footer. Every value resolves to a
   tokens.css variable. */
import Shell from '../layouts/Shell.astro';
---

