---
/* Writing landing — re-skinned onto the new system (Shell + landing tokens).
   Production composition KEPT (hero → chronological article index → podcasts);
   only the visual direction changed: old global.css tokens → --paper/--ink/
   --red/--display/--sans/--serif, radius → --r. One structural add: every
   article row now carries its homepage artwork thumbnail. Every colour, font,
   and radius resolves to a tokens.css variable — no raw hex lives in this file. */
import Shell from '../../layouts/Shell.astro';
---

<Shell
  title="Writing — Basit Masood"
  description="Essays, opinions, and things I wish someone told me earlier — on design leadership, AI, hiring, and the systems behind product work."
  active="writing"
>

<!-- HERO -->
<section class="wr-hero">
  <div class="wr-hero-inner reveal">
    <p class="wr-hero-kicker">Essays · 2025 – Present</p>
    <h1 class="wr-hero-title">Notes<em>.</em></h1>
    <p class="wr-hero-sub">Opinions, lessons, and things I wish someone had told me earlier — about design leadership, AI, hiring, and the systems behind product work.</p>
  </div>
</section>

<!-- ARTICLE LIST -->
<section class="wr-list">
  <p class="wr-list-label">All articles · 4</p>

  <a href="/writing/ai-didnt-kill-the-designers-job" class="wr-row reveal">
    <span class="wr-row-thumb"><img src="/landing/images/writing/ai.jpg" alt="A red line weaving unbroken through machine-ruled black lines" loading="lazy" /></span>
    <span class="wr-row-content">
      <span class="wr-row-meta">March 2026 · 5 min read</span>
      <span class="wr-row-title">AI didn't kill the designer's job.</span>
      <span class="wr-row-excerpt">Design isn't going anywhere — but the designers who refuse to evolve might.</span>
    </span>
    <span class="wr-row-go" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg>
    </span>
  </a>

  <a href="/writing/the-1-12-ratio" class="wr-row reveal">
    <span class="wr-row-thumb"><img src="/landing/images/writing/ratio.jpg" alt="A grid of black circles with one red at the centre" loading="lazy" /></span>
    <span class="wr-row-content">
      <span class="wr-row-meta">February 2026 · 4 min read</span>
      <span class="wr-row-title">The 1:12 ratio.</span>
      <span class="wr-row-excerpt">Out of every twelve candidates, only one gets through. Here's what I look for — and why portfolios aren't the answer.</span>
    </span>
    <span class="wr-row-go" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg>
    </span>
  </a>

  <a href="/writing/design-systems-that-outlast" class="wr-row reveal">
    <span class="wr-row-thumb"><img src="/landing/images/writing/systems.jpg" alt="Black modules locking like masonry around one red load-bearing block" loading="lazy" /></span>
    <span class="wr-row-content">
      <span class="wr-row-meta">January 2026 · 6 min read</span>
      <span class="wr-row-title">Design systems that outlast their designer.</span>
      <span class="wr-row-excerpt">Nukta, Techtonic, and the quiet discipline of building a system the next person can run without you in the room.</span>
    </span>
    <span class="wr-row-go" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg>
    </span>
  </a>

  <a href="/writing/watching-merchants" class="wr-row reveal">
    <span class="wr-row-thumb"><img src="/landing/images/writing/merchants.jpg" alt="Black flow-lines with one red line breaking onto its own path" loading="lazy" /></span>
    <span class="wr-row-content">
      <span class="wr-row-meta">December 2025 · 4 min read</span>
      <span class="wr-row-title">Watching merchants ignore our product.</span>
      <span class="wr-row-excerpt">Standing in shops for hours taught me more than any moderated user test ever could.</span>
    </span>
    <span class="wr-row-go" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg>
    </span>
  </a>
</section>

<!-- PODCASTS — video grid with YouTube thumbnails -->
<section class="wr-pods">
  <header class="wr-pods-head reveal">
    <p class="wr-pods-kicker">Spoken · 2</p>
    <h2 class="wr-pods-heading">On the record<em>.</em></h2>
    <p class="wr-pods-sub">Two podcast conversations about design leadership, AI, and shipping fintech UX in Pakistan.</p>
  </header>

  <div class="wr-pods-grid">
    <a href="https://www.youtube.com/watch?v=OMjy2ZvmqxQ" target="_blank" rel="noopener" class="wr-pod reveal">
      <div class="wr-pod-thumb">
        <img src="https://i.ytimg.com/vi/OMjy2ZvmqxQ/maxresdefault.jpg" alt="Campus2Career episode thumbnail" loading="lazy" />
        <span class="wr-pod-play" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4 13.5 8 6 12Z"/></svg>
        </span>
      </div>
      <div class="wr-pod-meta">
        <span class="wr-pod-channel">Campus2Career</span>
        <h3 class="wr-pod-title">How SadaPay built seamless UX.</h3>
        <p class="wr-pod-date">April 2026 · Watch on YouTube <svg class="wr-pod-ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg></p>
      </div>
    </a>

    <a href="https://www.youtube.com/watch?v=g6Pl-sw45Mw" target="_blank" rel="noopener" class="wr-pod reveal">
      <div class="wr-pod-thumb">
        <img src="https://i.ytimg.com/vi/g6Pl-sw45Mw/maxresdefault.jpg" alt="The Duct Tapes episode thumbnail" loading="lazy" />
        <span class="wr-pod-play" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4 13.5 8 6 12Z"/></svg>
        </span>
      </div>
      <div class="wr-pod-meta">
        <span class="wr-pod-channel">The Duct Tapes</span>
        <h3 class="wr-pod-title">Leading product design at SadaPay.</h3>
        <p class="wr-pod-date">March 2024 · Watch on YouTube <svg class="wr-pod-ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg></p>
      </div>
    </a>
  </div>
</section>

<style>
  /* ── tokens local to this page ── */
  .wr-hero, .wr-list, .wr-pods { --edge: clamp(24px, 5vw, 80px); --max: 1280px; }

  /* ── HERO ── */
  .wr-hero {
    padding: clamp(150px, 20vh, 220px) var(--edge) clamp(70px, 9vh, 120px);
    max-width: var(--max); margin: 0 auto;
  }
  .wr-hero-inner { max-width: 960px; }
  .wr-hero-kicker {
    font-family: var(--sans);
    font-size: 12px; font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--ink-50);
    margin: 0 0 28px;
  }
  .wr-hero-kicker::before {
    content: ''; display: inline-block;
    width: 36px; height: 1px;
    background: var(--red);
    margin-right: 16px; vertical-align: middle;
  }
  .wr-hero-title {
    font-family: var(--display);
    font-size: clamp(96px, 16vw, 220px);
    font-weight: 400; line-height: .86;
    letter-spacing: -.02em; text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 28px;
  }
  .wr-hero-title em { color: var(--red); font-style: normal; }
  .wr-hero-sub {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(20px, 2vw, 26px); line-height: 1.45;
    color: var(--ink-65);
    max-width: 52ch; margin: 0;
  }

  /* ── ARTICLE LIST ── */
  .wr-list {
    padding: 0 var(--edge) clamp(110px, 15vh, 170px);
    max-width: var(--max); margin: 0 auto;
  }
  .wr-list-label {
    font-family: var(--sans);
    font-size: var(--fs-micro); font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--ink-50);
    margin: 0 0 4px; padding-bottom: 18px;
    border-bottom: 1px solid var(--ink-12);
  }
  .wr-list-label::before {
    content: ''; display: inline-block;
    width: 32px; height: 1px; background: var(--red);
    margin-right: 14px; vertical-align: middle;
  }
  .wr-row {
    display: grid;
    grid-template-columns: clamp(180px, 18vw, 240px) 1fr auto;
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
    padding: 32px 0;
    border-bottom: 1px solid var(--ink-12);
    text-decoration: none; color: inherit;
    transition: padding .35s cubic-bezier(.16,1,.3,1), background .3s ease;
  }
  .wr-row:hover {
    background: var(--ink-08);
    padding-left: 24px; padding-right: 24px;
  }
  .wr-row-thumb {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--ink-08);
  }
  .wr-row-thumb img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .wr-row:hover .wr-row-thumb img { transform: scale(1.05); }
  .wr-row-content {
    display: flex; flex-direction: column;
    gap: 12px; min-width: 0;
  }
  .wr-row-meta {
    font-family: var(--sans);
    font-size: var(--fs-micro); font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-50);
  }
  .wr-row-title {
    font-family: var(--display);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 400; line-height: 1;
    text-transform: uppercase; letter-spacing: -.005em;
    color: var(--ink);
    transition: color .3s ease;
  }
  .wr-row:hover .wr-row-title { color: var(--red); }
  .wr-row-excerpt {
    font-family: var(--serif);
    font-size: 16px; line-height: 1.5;
    color: var(--ink-65);
    max-width: 58ch;
  }
  /* system icon chip — line icon in a circle; ink at rest, red on hover */
  .wr-row-go {
    width: 48px; height: 48px; flex: 0 0 auto;
    border-radius: 50%;
    background: var(--ink-08); color: var(--ink);
    display: inline-flex; align-items: center; justify-content: center;
    justify-self: end;
    transition: background .3s ease, color .3s ease, transform .35s cubic-bezier(.16,1,.3,1);
  }
  .wr-row-go svg { width: 16px; height: 16px; }
  .wr-row:hover .wr-row-go {
    background: var(--red); color: var(--white);
    transform: translate(3px, -3px);
  }

  @media (max-width: 1024px) {
    .wr-row {
      grid-template-columns: 120px 1fr auto;
      gap: 20px;
      padding: 24px 0;
    }
    .wr-row-thumb { aspect-ratio: 4 / 5; }
    .wr-row-title { font-size: 24px; }
    .wr-row-go { width: 40px; height: 40px; }
  }
  @media (max-width: 560px) {
    .wr-row { grid-template-columns: 92px 1fr; gap: 16px; }
    .wr-row-go { display: none; }
  }

  /* ── PODCASTS ── */
  .wr-pods {
    padding: clamp(80px, 12vh, 140px) var(--edge) clamp(110px, 15vh, 170px);
    max-width: var(--max); margin: 0 auto;
    border-top: 1px solid var(--ink-12);
  }
  .wr-pods-head { max-width: 720px; margin-bottom: 56px; }
  .wr-pods-kicker {
    font-family: var(--sans);
    font-size: var(--fs-micro); font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--ink-50); margin: 0 0 24px;
  }
  .wr-pods-kicker::before {
    content: ''; display: inline-block;
    width: 32px; height: 1px; background: var(--red);
    margin-right: 14px; vertical-align: middle;
  }
  .wr-pods-heading {
    font-family: var(--display);
    font-size: clamp(56px, 8vw, 120px);
    font-weight: 400; line-height: .9;
    letter-spacing: -.015em; text-transform: uppercase;
    color: var(--ink); margin: 0 0 24px;
  }
  .wr-pods-heading em { color: var(--red); font-style: normal; }
  .wr-pods-sub {
    font-family: var(--serif);
    font-size: 18px; line-height: 1.55;
    color: var(--ink-65); max-width: 56ch; margin: 0;
  }
  .wr-pods-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px;
  }
  .wr-pod {
    display: flex; flex-direction: column; gap: 22px;
    text-decoration: none; color: inherit;
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }
  .wr-pod:hover { transform: translateY(-6px); }
  .wr-pod-thumb {
    position: relative; aspect-ratio: 16 / 9;
    border-radius: var(--r); overflow: hidden;
    background: var(--ink-08);
  }
  .wr-pod-thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .wr-pod:hover .wr-pod-thumb img { transform: scale(1.04); }
  .wr-pod-play {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none;
  }
  .wr-pod-play::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(var(--coal-rgb),0) 50%, rgba(var(--coal-rgb),.45) 100%);
    transition: background .3s ease;
  }
  .wr-pod:hover .wr-pod-play::before {
    background: linear-gradient(180deg, rgba(var(--coal-rgb),.15) 50%, rgba(var(--coal-rgb),.55) 100%);
  }
  .wr-pod-play svg {
    position: relative; z-index: 2;
    width: 64px; height: 64px; padding: 18px;
    border-radius: var(--r-pill);
    background: var(--paper); color: var(--red);
    box-shadow: 0 8px 24px rgba(var(--coal-rgb),.25);
    transition: transform .4s cubic-bezier(.16,1,.3,1), background .3s ease, color .3s ease;
  }
  .wr-pod-play svg path { stroke-linejoin: miter; }
  .wr-pod:hover .wr-pod-play svg {
    transform: scale(1.1); background: var(--red); color: var(--white);
  }
  .wr-pod-meta { display: flex; flex-direction: column; gap: 8px; }
  .wr-pod-channel {
    font-family: var(--sans);
    font-size: var(--fs-micro); font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-50);
  }
  .wr-pod-title {
    font-family: var(--display);
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 400; line-height: 1;
    text-transform: uppercase; letter-spacing: -.005em;
    color: var(--ink); margin: 0;
    transition: color .3s ease;
  }
  .wr-pod:hover .wr-pod-title { color: var(--red); }
  .wr-pod-date {
    font-family: var(--serif);
    font-size: 14px; line-height: 1.5;
    color: var(--ink-65); margin: 0;
  }
  .wr-pod-ext {
    width: 11px; height: 11px;
    vertical-align: -1px; margin-left: 5px;
    color: var(--ink-50);
    transition: color .3s ease, transform .3s ease;
  }
  .wr-pod:hover .wr-pod-ext { color: var(--red); transform: translate(2px, -2px); }
  @media (max-width: 900px) {
    .wr-pods-grid { grid-template-columns: 1fr; gap: 32px; }
    .wr-pod-play svg { width: 52px; height: 52px; padding: 14px; }
  }

  /* ── reveal ── */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
  .reveal.revealed { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .wr-pod:hover { transform: none; }
    .wr-row:hover .wr-row-thumb img,
    .wr-pod:hover .wr-pod-thumb img,
    .wr-pod:hover .wr-pod-play svg { transform: none; }
  }
</style>

<script>
  function initWriting() {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('revealed'));
    }
  }
  initWriting();
</script>

</Shell>
