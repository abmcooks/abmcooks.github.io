        <div class="sl-card c-coral">
          <p class="sl-tag">Users, from zero</p>
          <p class="sl-giant" data-counter="users">0</p>
        </div>
        <div class="sl-card c-blue">
          <p class="sl-tag">Five products</p>
          <div class="sl-chips">
