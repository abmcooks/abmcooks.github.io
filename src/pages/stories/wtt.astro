            <circle r="130" fill="none" stroke="rgba(6,6,6,0.08)" stroke-width="1"/>
            <circle r="90" fill="none" stroke="rgba(6,6,6,0.08)" stroke-width="1"/>
            <g stroke="rgba(6,6,6,0.35)" stroke-width="1" fill="rgba(6,6,6,0.04)">
              <path d="M 0 0 L 150 0 A 150 150 0 0 1 75 129.9 Z"/>
              <path d="M 0 0 L 75 129.9 A 170 170 0 0 1 -85 147.22 Z"/>
              <path d="M 0 0 L -85 147.22 A 130 130 0 0 1 -130 0 Z"/>
              <path d="M 0 0 L -150 0 A 150 150 0 0 1 -75 -129.9 Z"/>
              <path d="M 0 0 L -75 -129.9 A 170 170 0 0 1 85 -147.22 Z"/>
