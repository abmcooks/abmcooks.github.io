<script>
  function initSub() {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('revealed'));
    }
  }

  function initWlDiff() {
    const stage = document.getElementById('wlDiffStage');
    if (!stage) return;
    const handle = stage.querySelector('.wl-diff-handle') as HTMLElement | null;
    const after = stage.querySelector('.wl-diff-pane--after') as HTMLElement | null;
    if (!handle || !after) return;

    let dragging = false;

    const setPos = (clientX: number) => {
      const rect = stage.getBoundingClientRect();
      let pct = ((clientX - rect.left) / rect.width) * 100;
      pct = Math.max(2, Math.min(98, pct));
      after.style.clipPath = `inset(0 0 0 ${pct}%)`;
      handle.style.left = `${pct}%`;
    };

    const onDown = (e: MouseEvent | TouchEvent) => {
      dragging = true;
      if ('touches' in e) e.preventDefault();
    };
    const onMove = (e: MouseEvent | TouchEvent) => {
      if (!dragging) return;
      const x = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
      setPos(x);
    };
    const onUp = () => { dragging = false; };

    handle.addEventListener('mousedown', onDown);
    stage.addEventListener('mousedown', onDown);
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
    handle.addEventListener('touchstart', onDown, { passive: false });
    document.addEventListener('touchmove', onMove, { passive: false });
    document.addEventListener('touchend', onUp);

    stage.addEventListener('click', (e: MouseEvent) => {
      const t = e.target as HTMLElement;
      if (t.closest('.wl-diff-handle')) return;
      setPos(e.clientX);
    });

    handle.addEventListener('keydown', (e: KeyboardEvent) => {
      const rect = stage.getBoundingClientRect();
      const currentPct = parseFloat(handle.style.left) || 50;
      if (e.key === 'ArrowLeft') {
        setPos(rect.left + ((currentPct - 5) / 100) * rect.width);
        e.preventDefault();
      }
      if (e.key === 'ArrowRight') {
        setPos(rect.left + ((currentPct + 5) / 100) * rect.width);
        e.preventDefault();
      }
    });
  }

  let wlZoomReady = false;
  function initWlZoom() {
    if (wlZoomReady) return;
    const modal = document.getElementById('wlZoom') as HTMLDialogElement | null;
    if (!modal) return;
    const img = document.getElementById('wlZoomImg') as HTMLImageElement | null;
    const stage = document.getElementById('wlZoomStage') as HTMLElement | null;
    const closeBtn = document.getElementById('wlZoomClose') as HTMLButtonElement | null;
    if (!img || !stage || !closeBtn) return;
    wlZoomReady = true;

    // Selectors that should open the lightbox when clicked
    const zoomSelectors = [
      '.wl-shot-img',
      '.wl-specimen-img',
      '.wl-leaderboard-img',
      '.wl-landscape-img',
      '.wl-team-img',
    ];

    document.querySelectorAll<HTMLImageElement>(zoomSelectors.join(',')).forEach((el) => {
      el.classList.add('wl-zoomable');
      el.addEventListener('click', () => {
        img.src = el.currentSrc || el.src;
        img.alt = el.alt;
        stage.classList.remove('is-zoomed');
        stage.scrollTo(0, 0);
        modal.showModal();
      });
    });

    // Image click toggles zoom in/out
    img.addEventListener('click', (e) => {
      e.stopPropagation();
      stage.classList.toggle('is-zoomed');
      if (!stage.classList.contains('is-zoomed')) {
        stage.scrollTo(0, 0);
      }
    });

    // Stage backdrop click (anywhere outside the image) closes the modal
    stage.addEventListener('click', (e) => {
      if (e.target === stage) {
        modal.close();
      }
    });

    // Close handlers
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('close', () => {
      stage.classList.remove('is-zoomed');
      img.src = '';
    });
  }

  initSub();
  initWlDiff();
  initWlZoom();
  document.addEventListener('astro:page-load', () => {
    initSub();
    initWlDiff();
    initWlZoom();
  });
</script>

