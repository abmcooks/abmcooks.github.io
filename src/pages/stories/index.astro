---
import Shell from '../../layouts/Shell.astro';
---

<Shell
  title="Stories — Basit Masood"
  description="Thirty products shipped. Six million users. Two acquisitions. The work of Basit Masood."
  active="stories"
>

<!-- ════ HERO (centered) ════ -->
<header class="sti-hero shell">
  <p class="sti-kicker"><span class="sti-kicker-rule"></span>Selected work · 2018 – Present<span class="sti-kicker-rule"></span></p>
  <h1 class="sti-title">Hall of fame<em>.</em></h1>
  <div class="sti-stats">
    <div class="stat"><div class="stat-v">6M+</div><div class="stat-l">Users reached</div></div>
    <div class="stat"><div class="stat-v">30+</div><div class="stat-l">Products shipped</div></div>
    <div class="stat"><div class="stat-v">$90M+</div><div class="stat-l">Raised by my products</div></div>
    <div class="stat"><div class="stat-v">8+</div><div class="stat-l">Years in product</div></div>
  </div>
</header>

<!-- ════ THE THREE HEADLINE STORIES ════ -->
<section class="sti-feats shell">

  <!-- SadaPay -->
  <a href="/stories/sadapay" class="sti-feat rv">
    <div class="sti-feat-text">
      <p class="sti-feat-eyebrow">2020 – 2024 · Founding Designer → Head of Product Design</p>
      <h2 class="sti-feat-name">SadaPay<em>.</em></h2>
      <p class="sti-feat-sub">Pakistan's first fintech exit. The first designer, building from zero.</p>
      <div class="sti-feat-metrics">
        <span><strong>4M+</strong>users</span>
        <span><strong>$1.5B+</strong>processed yearly</span>
        <span><strong>700K+</strong>pre-launch waitlist</span>
        <span><strong>$50M</strong>acquisition</span>
      </div>
      <span class="btn-circle"><span class="big"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg></span><span class="lbl">Read story</span></span>
    </div>
    <div class="sti-feat-visual">
      <div class="sti-logo-panel">
        <img src="/landing/images/sadapay/sadapay-wordmark.svg" alt="SadaPay" />
        <span class="sti-logo-rule"></span>
        <span class="sti-logo-cap">Founding Designer · Dec 2020 – Aug 2024</span>
      </div>
    </div>
  </a>

  <!-- ZAR -->
  <a href="/stories/zar" class="sti-feat rv">
    <div class="sti-feat-text">
      <p class="sti-feat-eyebrow">2024 – 2026 · Head of Product Design</p>
      <h2 class="sti-feat-name">ZAR<em>.</em></h2>
      <p class="sti-feat-sub">An instant global wallet, backed by a16z.</p>
      <div class="sti-feat-metrics">
        <span><strong>300K+</strong>users</span>
        <span><strong>110+</strong>countries live</span>
        <span><strong>$20M</strong>Series A</span>
      </div>
      <span class="btn-circle"><span class="big"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg></span><span class="lbl">Read story</span></span>
    </div>
    <div class="sti-feat-visual">
      <div class="sti-logo-panel">
        <img src="/images/ZAR-full-logo.svg" alt="ZAR" />
        <span class="sti-logo-rule"></span>
        <span class="sti-logo-cap">Head of Product Design · Nov 2024 – Jul 2026</span>
      </div>
    </div>
  </a>

  <!-- Walking the Talk -->
  <a href="/stories/wtt" class="sti-feat rv">
    <div class="sti-feat-text">
      <p class="sti-feat-eyebrow">2023 – 2024 · Lead Product Design Consultant</p>
      <h2 class="sti-feat-name">Walking the Talk<em>.</em></h2>
      <p class="sti-feat-sub">Culture-change tools for the world's biggest companies. Now part of ZRG.</p>
      <div class="sti-feat-metrics">
        <span><strong>200K+</strong>leaders assessed</span>
        <span><strong>200</strong>organizations</span>
        <span><strong>40</strong>countries</span>
      </div>
      <span class="btn-circle"><span class="big"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4M5 4h7v7"/></svg></span><span class="lbl">Read story</span></span>
    </div>
    <div class="sti-feat-visual">
      <div class="sti-logo-panel">
        <img src="/images/WTT-full-logo.svg" alt="Walking the Talk" />
        <span class="sti-logo-rule"></span>
        <span class="sti-logo-cap">Lead Product Design Consultant · 2023 – 2024</span>
      </div>
    </div>
  </a>
</section>

<!-- ════ THE REST — products with logos + prominent stats ════ -->
<section class="sti-rest shell">
  <div class="sec-intro">
    <div>
      <h2 class="h2">Also<em>.</em></h2>
      <p class="sec-sub">Full-time roles and consulting engagements alike — every one shipped and used by real people.</p>
    </div>
  </div>

  <div class="sti-index">
    <a class="work-row rv" href="/stories/adib">
      <span class="wr-body">
        <span class="work-name">ADIB</span>
        <span class="work-meta">
          <span class="wr-stat"><span class="wr-stat-v">1M+</span><span class="wr-stat-l">App users</span></span>
          <span class="work-line">Lead Product Designer · 2022 · Remit! by Visa, open banking, design ops &amp; governance for the Middle East's leading Islamic bank.</span>
        </span>
      </span>
      <span class="wr-logo"><img src="/images/ADIB-full-logo.svg" alt="Abu Dhabi Islamic Bank" /></span>
    </a>
    <a class="work-row rv" href="/stories/bolt-vpn">
      <span class="wr-body">
        <span class="work-name">Bolt VPN</span>
        <span class="work-meta">
          <span class="wr-stat"><span class="wr-stat-v">25M+</span><span class="wr-stat-l">Downloads</span></span>
          <span class="work-line">Lead Product Design Consultant · 2021 · Brand overhaul, UI/UX transformation, and paywall optimization via Galixo AI.</span>
        </span>
      </span>
      <span class="wr-logo"><img src="/images/boltvpn-logo.png" alt="Bolt VPN" /></span>
    </a>
    <a class="work-row rv" href="/stories/gosaas">
      <span class="wr-body">
        <span class="work-name">GoCompliance</span>
        <span class="work-meta">
          <span class="wr-stat"><span class="wr-stat-v">200+</span><span class="wr-stat-l">Enterprise clients</span></span>
          <span class="work-line">Lead Product Design Consultant · 2020 · Compliance automation with Oracle — cut manual effort ~70% across 200+ enterprise clients.</span>
        </span>
      </span>
      <span class="wr-logo"><img src="/images/gocompliance-full-logo.svg" alt="GoCompliance" /></span>
    </a>
    <a class="work-row rv" href="/stories/xpence">
      <span class="wr-body">
        <span class="work-name">Xpence</span>
        <span class="work-meta">
          <span class="wr-stat"><span class="wr-stat-v">50K+</span><span class="wr-stat-l">Business users</span></span>
          <span class="work-line">Product Designer · 2019 · Expense management, virtual cards, spend analytics for SMEs in the Middle East.</span>
        </span>
      </span>
      <span class="wr-logo"><img src="/images/xpence-full-logo.svg" alt="Xpence" /></span>
    </a>
  </div>

  <p class="sti-more">And many more<em>.</em></p>
</section>

<style>
  /* ── HERO (centered) ── */
  .sti-hero{
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
    padding:140px 0 96px;
  }
  .sti-kicker{
    display:flex; align-items:center; justify-content:center; gap:14px;
    font-family:var(--sans); font-size:var(--fs-label); font-weight:600;
    letter-spacing:.18em; text-transform:uppercase; color:var(--ink-50);
  }
  .sti-kicker-rule{ width:40px; height:var(--hairline); background:var(--ink-25); display:inline-block; }
  .sti-title{
    font-family:var(--display); text-transform:uppercase; font-weight:400;
    font-size:clamp(72px,14vw,240px); line-height:.9; color:var(--ink); margin:24px 0 0;
  }
  .sti-title em{ font-style:normal; color:var(--red); }
  .sti-lede{
    font-family:var(--serif); font-size:var(--fs-body-lg); line-height:1.55;
    color:var(--ink-65); max-width:52ch; margin:28px auto 0;
  }
  .sti-stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:24px;
    margin-top:64px; width:100%; max-width:920px;
  }
  .sti-stats .stat{ text-align:center; border-top:var(--hairline) solid var(--ink-12); padding-top:20px; }

  /* ── FEATURE STORIES ── */
  .sti-feats{ padding-bottom:var(--sp-sec-bot); }
  .sti-feat{
    display:grid; grid-template-columns:1fr auto; gap:64px; align-items:center;
    padding:72px 0; border-top:var(--hairline) solid var(--ink-12);
    text-decoration:none; transition:padding-left var(--t-base) var(--ease);
  }
  .sti-feat:hover{ padding-left:16px; }
  .sti-feat-eyebrow{ font-family:var(--sans); font-size:var(--fs-ui); font-weight:500; color:var(--ink-50); }
  .sti-feat-name{ font-family:var(--display); text-transform:uppercase; font-weight:400; font-size:var(--fs-display-md); line-height:1; color:var(--ink); margin:14px 0 0; }
  .sti-feat-name em{ font-style:normal; color:var(--red); }
  .sti-feat-sub{ font-family:var(--serif); font-size:var(--fs-body-lg); line-height:1.5; color:var(--ink-65); max-width:44ch; margin-top:16px; }
  .sti-feat-metrics{ display:flex; flex-wrap:wrap; gap:40px; margin-top:32px; }
  .sti-feat-metrics span{ display:flex; flex-direction:column; gap:6px; font-family:var(--sans); font-size:var(--fs-md); color:var(--ink-50); }
  .sti-feat-metrics strong{ font-family:var(--display); text-transform:uppercase; font-weight:400; font-size:clamp(28px,2.8vw,40px); line-height:1; color:var(--ink); letter-spacing:.01em; }
  .sti-feat .btn-circle{ margin-top:40px; align-items:flex-start; }
  .sti-feat .btn-circle .big{ width:72px; height:72px; transition:transform var(--t-base) var(--ease), background var(--t-fast) var(--ease); }
  .sti-feat .btn-circle .big svg{ width:24px; height:24px; }
  .sti-feat:hover .btn-circle .big{ transform:translate(6px,-6px) scale(1.18); background:var(--red-deep); }

  .sti-feat-visual{ width:clamp(280px,30vw,380px); flex:0 0 auto; }
  .sti-logo-panel{
    display:flex; flex-direction:column; align-items:center; gap:24px;
    padding:48px 40px; background:var(--white);
    border:var(--hairline) solid var(--ink-12); border-radius:var(--r);
    transition:border-color var(--t-base) var(--ease);
  }
  .sti-feat:hover .sti-logo-panel{ border-color:var(--red); }
  .sti-logo-panel img{ max-width:260px; max-height:96px; width:auto; height:auto; object-fit:contain; }
  .sti-logo-panel img.sti-logo-mark{ max-width:120px; max-height:120px; }
  .sti-logo-rule{ width:48px; height:var(--stroke); background:var(--emerald); }
  .sti-logo-cap{ font-family:var(--sans); font-size:var(--fs-label); color:var(--ink-50); text-align:center; line-height:1.4; }

  /* ── THE REST — work index (logo · outlined name · prominent stat) ── */
  .sti-rest{ padding-bottom:var(--sp-sec-bot-lg); }
  .sti-index{ margin-top:8px; border-bottom:var(--hairline) solid var(--ink-12); }
  .sti-index .work-row{ display:grid; grid-template-columns:1fr auto; gap:56px; align-items:center; }
  .wr-body{ display:flex; flex-direction:column; gap:20px; }
  .sti-index .work-meta{ display:flex; flex-direction:column; align-items:flex-start; gap:12px; text-align:left; max-width:64ch; margin:0; }
  .wr-stat{ display:flex; flex-direction:column; align-items:flex-start; gap:4px; }
  .wr-stat-v{ font-family:var(--display); text-transform:uppercase; font-weight:400; font-size:clamp(28px,3vw,44px); line-height:1; color:var(--ink); }
  .wr-stat-l{ font-family:var(--sans); font-size:var(--fs-md); font-weight:500; color:var(--ink-50); }
  .sti-index .work-line{ margin-top:0; }
  .sti-index .work-row:hover .work-name{ color:var(--red); -webkit-text-stroke-color:var(--red); }
  .wr-logo{ display:flex; align-items:center; justify-content:flex-end; flex:0 0 auto; width:clamp(180px,20vw,260px); }
  .wr-logo img{
    max-height:80px; max-width:100%; width:auto; height:auto; object-fit:contain;
    filter:brightness(0); opacity:.72;
    transition:filter var(--t-base) var(--ease), opacity var(--t-base) var(--ease);
  }
  .work-row:hover .wr-logo img{ filter:none; opacity:1; }

  .sti-more{
    font-family:var(--display); text-transform:uppercase; font-weight:400;
    font-size:var(--fs-display-md); line-height:1; color:var(--ink); margin-top:56px;
  }
  .sti-more em{ font-style:normal; color:var(--red); }

  /* ── MOBILE ── */
  @media (max-width:900px){
    .sti-hero{ padding:120px 0 var(--sp-sec-bot); }
    .sti-stats{ grid-template-columns:repeat(2,1fr); gap:20px; margin-top:48px; }
    .sti-feat{ grid-template-columns:1fr; gap:32px; padding:48px 0; }
    .sti-feat:hover{ padding-left:0; }
    .sti-feat-visual{ width:100%; max-width:340px; }
    .sti-index .work-row{ grid-template-columns:1fr; gap:24px; padding:32px 0; }
    .sti-index .work-row:hover{ padding-left:0; }
    .wr-logo{ justify-content:flex-start; width:auto; order:-1; }
    .wr-logo img{ max-height:48px; max-width:160px; }
    .sti-index .work-meta{ max-width:none; }
  }
</style>

</Shell>
